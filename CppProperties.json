{
  "configurations": [
    {
      "name": "x64-Debug-C++17",
      "inheritEnvironments": [
        "msvc_x64"
      ],
      "includePath": [
        "${env.INCLUDE}",
        "${workspaceRoot}/**"
      ],
      "defines": [
        "WIN32",
        "_DEBUG"
      ],
      "cStandard": "c17",
      "cppStandard": "c++17",
      "compilerSwitches": "/std:c++17",
      "intelliSenseMode": "windows-msvc-x64"
    },
    {
      "name": "x64-Debug-C++20",
      "inheritEnvironments": [
        "msvc_x64"
      ],
      "includePath": [
        "${env.INCLUDE}",
        "${workspaceRoot}/**"
      ],
      "defines": [
        "WIN32",
        "_DEBUG"
      ],
      "cStandard": "c17",
      "cppStandard": "c++20",
      "compilerSwitches": "/std:c++20",
      "intelliSenseMode": "windows-msvc-x64"
    }
  ]
}
